def hub_owner_card(hub):
    """The card the owner used when opening the hub (their active card at that time)."""
    return Card.query.filter_by(id=hub.owner_card_id).first()


@app.route("/api/hubs", methods=["GET"])
def list_hubs():
    user, _ = get_or_create_user()
    scope = request.args.get("filter", "all")  # all | near | favorites | mine

    query = Hub.query.filter_by(is_open=True)

    if scope == "mine":
        query = query.filter_by(owner_user_id=user.id)  # owner sees their own drafts too
    else:
        query = query.filter_by(is_published=True)  # everyone else only sees published hubs
        if scope == "favorites":
            fav_hub_ids = [f.hub_id for f in Favorite.query.filter_by(user_id=user.id).all()]
            query = query.filter(Hub.id.in_(fav_hub_ids)) if fav_hub_ids else query.filter(False)
        elif scope == "near":
            my_ip = get_client_ip()
            query = query.filter(Hub.owner_public_ip == my_ip) if my_ip else query.filter(False)
        # scope == "all" -> no extra filter

    hubs = query.order_by(Hub.created_at.desc()).all()
    fav_ids = {f.hub_id for f in Favorite.query.filter_by(user_id=user.id).all()}

    result = []
    for hub in hubs:
        owner_card = hub_owner_card(hub)
        d = hub.public_dict(owner_card)
        d["is_favorite"] = hub.id in fav_ids
        d["is_mine"] = hub.owner_user_id == user.id
        d["is_physical"] = (hub.owner_public_ip == get_client_ip())
        result.append(d)
    return jsonify(result)


@app.route("/api/hubs/search", methods=["GET"])
def search_hubs():
    q = (request.args.get("q") or "").strip()
    if not q:
        return jsonify([])
    user, _ = get_or_create_user()
    query = Hub.query.filter_by(is_open=True).filter(
        db.or_(Hub.name.ilike(f"%{q}%"), Hub.serial == q)
    ).filter(db.or_(Hub.is_published == True, Hub.owner_user_id == user.id)).order_by(Hub.created_at.desc()).limit(15)  # noqa: E712
    fav_ids = {f.hub_id for f in Favorite.query.filter_by(user_id=user.id).all()}
    result = []
    for hub in query.all():
        owner_card = hub_owner_card(hub)
        d = hub.public_dict(owner_card)
        d["is_favorite"] = hub.id in fav_ids
        d["is_mine"] = hub.owner_user_id == user.id
        d["is_physical"] = (hub.owner_public_ip == get_client_ip())
        result.append(d)
    return jsonify(result)


@app.route("/api/hubs/<hub_id>", methods=["GET"])
def get_hub(hub_id):
    """Lightweight lookup used by the invite-link landing flow (?hub=<id>)
    to show 'you've been invited to X' before the person has a card yet,
    without requiring a live socket join."""
    user, _ = get_or_create_user()
    hub = Hub.query.filter_by(id=hub_id, is_open=True).first()
    if not hub:
        return jsonify({"error": "not found or closed"}), 404
    if not hub.is_published and hub.owner_user_id != user.id:
        return jsonify({"error": "not found or closed"}), 404
    owner_card = hub_owner_card(hub)
    return jsonify(hub.public_dict(owner_card))


@app.route("/api/hubs", methods=["POST"])
def open_hub():
    user, _ = get_or_create_user()
    active_card = Card.query.filter_by(user_id=user.id, is_active=True).first()
    if not active_card:
        return jsonify({"error": "Create and activate a card before opening a hub."}), 400

    data = request.get_json(force=True)
    name = (data.get("name") or "").strip()
    if not name:
        return jsonify({"error": "Hub name is required."}), 400
    hub_type = data.get("hub_type")
    if hub_type not in ("social", "professional", "business"):
        return jsonify({"error": "hub_type must be 'social', 'professional' or 'business'"}), 400

    serial = gen_hub_serial()
    while Hub.query.filter_by(serial=serial).first():
        serial = gen_hub_serial()

    VALID_TEMPLATES = {"corporate_classic", "community_dynamic", "creator_purple", "minimalist_dark", "logistics_red"}
    template_id = data.get("template_id") if data.get("template_id") in VALID_TEMPLATES else "corporate_classic"

    hub = Hub(
        owner_user_id=user.id,
        owner_card_id=active_card.id,
        name=name,
        serial=serial,
        hub_type=hub_type,
        description=(data.get("description") or "").strip(),
        tagline=(data.get("tagline") or "").strip(),
        location=(data.get("location") or "").strip(),
        event_dates=(data.get("event_dates") or "").strip(),
        logo_url=data.get("logo_url") or "",
        auto_approve=bool(data.get("auto_approve")),
        template_id=template_id,
        # Conference hubs start as an unpublished draft the organizer can
        # preview and edit before anyone else can find or join it (spec
        # §4.3), unless they explicitly ask to publish immediately.
        is_published=not (hub_type == "professional" and not data.get("publish_now")),
        wifi_label=(data.get("wifi_label") or "").strip(),
        owner_public_ip=get_client_ip(),
        is_open=True,
    )
    db.session.add(hub)
    db.session.commit()
    d = hub.public_dict(active_card)
    d["is_favorite"] = False
    d["is_mine"] = True
    d["is_physical"] = True
    return jsonify(d)


@app.route("/api/hubs/<hub_id>/publish", methods=["POST"])
def publish_hub(hub_id):
    """Organizer publishes a draft conference hub, making it findable and
    joinable by anyone (spec §4.3's edit → preview → publish flow)."""
    user, _ = get_or_create_user()
    hub = Hub.query.filter_by(id=hub_id, owner_user_id=user.id).first()
    if not hub:
        return jsonify({"error": "not found or not yours"}), 404
    hub.is_published = True
    db.session.commit()
    return jsonify(hub.public_dict(hub_owner_card(hub)))


