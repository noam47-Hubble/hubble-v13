@socketio.on("disconnect")
def on_disconnect():
    user_id = SID_TO_USER.pop(request.sid, None)
    hub_id = SID_TO_HUB.pop(request.sid, None)
    if user_id and user_id in USER_SIDS:
        USER_SIDS[user_id].discard(request.sid)
        still_connected = bool(USER_SIDS[user_id])
        if not USER_SIDS[user_id]:
            del USER_SIDS[user_id]
        # Once ALL of this user's tabs/sockets for this hub are gone, mark
        # them offline rather than deleting their presence row — a
        # professional hub's attendee directory (spec §6) needs to keep
        # showing people who registered even while they're not currently
        # connected. (For social/business hubs this is invisible: the "who's
        # here now" list already only shows is_live rows, same as before.)
        if hub_id and not still_connected:
            presence = HubPresence.query.filter_by(hub_id=hub_id, user_id=user_id).first()
            if presence:
                presence.is_live = False
                db.session.commit()
            emit_presence_list(hub_id)


