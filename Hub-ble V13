@socketio.on("send_private_message")
def on_send_private_message(data):
    from_user_id = SID_TO_USER.get(request.sid)
    hub_id = SID_TO_HUB.get(request.sid)
    to_user_id = data.get("to_user_id")
    if not from_user_id or not hub_id or not to_user_id:
        return

    hub = Hub.query.get(hub_id)
    from_presence = HubPresence.query.filter_by(hub_id=hub_id, user_id=from_user_id).first()

    # A person blocked by the hub owner may still reach out to the OWNER
    # (to explain themselves / ask to be unblocked) but not to anyone else,
    # in either the general board or private messages.
    if from_presence and from_presence.is_blocked and hub and to_user_id != hub.owner_user_id:
        emit("error_msg", {"error": "נחסמת על ידי הבעלים. שלח לו הודעה פרטית."})
        return

    to_presence = HubPresence.query.filter_by(hub_id=hub_id, user_id=to_user_id).first()
    if not to_presence or to_presence.status != "green":
        emit("error_msg", {"error": "that person isn't open to messages right now"})
        return

    from_card = Card.query.get(from_presence.card_id) if from_presence else None

    text = (data.get("text") or "").strip()
    image = data.get("image") or ""
    if not text and not image:
        return

    pm = PrivateMessage(hub_id=hub_id, from_user_id=from_user_id, to_user_id=to_user_id,
                         text=text, image_url=image)
    db.session.add(pm)
    db.session.commit()

    payload = {
        "id": pm.id, "hub_id": hub_id,
        "from_user_id": from_user_id, "to_user_id": to_user_id,
        "from_name": from_card.display_name() if from_card else "Anonymous",
        "text": text, "image": image, "ts": pm.ts,
    }
    for sid in USER_SIDS.get(from_user_id, set()):
        socketio.emit("private_message", payload, room=sid)
    for sid in USER_SIDS.get(to_user_id, set()):
        socketio.emit("private_message", payload, room=sid)


@socketio.on("delete_private_message")
def on_delete_private_message(data):
    """Delete a private message I sent — usable from the in-hub private
    panel. (The 'My Messages' screen uses the REST DELETE endpoint instead,
    since it isn't necessarily connected to a hub's socket room.)"""
    user_id = SID_TO_USER.get(request.sid)
    msg_id = data.get("message_id")
    if not user_id or not msg_id:
        return
    msg = PrivateMessage.query.filter_by(id=msg_id).first()
    if not msg or msg.from_user_id != user_id:
        emit("error_msg", {"error": "אפשר למחוק רק הודעות שאתה שלחת"})
        return
    other_id = msg.to_user_id
    db.session.delete(msg)
    db.session.commit()
    payload = {"id": msg_id, "other_user_id": other_id}
    for sid in USER_SIDS.get(user_id, set()):
        socketio.emit("private_message_deleted", payload, room=sid)
    payload_for_other = {"id": msg_id, "other_user_id": user_id}
    for sid in USER_SIDS.get(other_id, set()):
        socketio.emit("private_message_deleted", payload_for_other, room=sid)


@socketio.on("share_contact")
def on_share_contact(data):
    """Sender chooses which fields of their card to expose and sends them to
    another participant. This does NOT save to the recipient's contacts by
    itself — the recipient explicitly saves it (with their own note) via
    POST /api/contacts, matching the spec's send -> review -> save flow."""
    from_user_id = SID_TO_USER.get(request.sid)
    hub_id = SID_TO_HUB.get(request.sid)
    to_user_id = data.get("to_user_id")
    fields = data.get("fields") or {}
    if not from_user_id or not hub_id or not to_user_id:
        return

    from_presence = HubPresence.query.filter_by(hub_id=hub_id, user_id=from_user_id).first()
    from_card = Card.query.get(from_presence.card_id) if from_presence else None
    hub = Hub.query.get(hub_id)
    if not from_card or not hub:
        return

    # only pass through fields the sender's card actually has marked visible-capable
    # (the sender explicitly picked these in the UI; we trust but scope to real field names)
    allowed = {k: v for k, v in fields.items() if k in FIELD_NAMES and v}

    payload = {
        "from_user_id": from_user_id,
        "from_name": from_card.display_name(),
        "hub_id": hub_id,
        "hub_name": hub.name,
        "fields": allowed,
    }
    for sid in USER_SIDS.get(to_user_id, set()):
        socketio.emit("contact_offer", payload, room=sid)


@socketio.on("owner_approve_attendee")
