# Phase 3 — inside a hub: presence, general board, private messages, contact sharing
# ---------------------------------------------------------------------------

# In-memory socket bookkeeping (fine for a single-process demo; would move to
# a shared store like Redis if this were ever scaled to multiple workers).
SID_TO_USER = {}    # sid -> user_id
SID_TO_HUB = {}     # sid -> hub_id
USER_SIDS = {}       # user_id -> set of sids (a person can have multiple tabs/devices)


def resolve_user_from_request():
    """Same identity lookup as the HTTP before_request hook, usable inside
    Socket.IO handlers (which don't go through Flask's before_request)."""
    device_id = request.cookies.get(DEVICE_COOKIE)
    if not device_id:
        return None
    return User.query.filter_by(device_id=device_id).first()


def compute_display_names(presences):
    """Resolve each presence's shown name, appending (1), (2)... on collisions,
    in join order, per the spec."""
    names_seen = {}
    result = {}  # presence.id -> display string
    ordered = sorted(presences, key=lambda p: p.joined_at)
    counts = {}
    for p in ordered:
        card = Card.query.get(p.card_id)
        base = card.display_name() if card else "Anonymous"
        counts[base] = counts.get(base, 0) + 1
    running = {}
    for p in ordered:
        card = Card.query.get(p.card_id)
        base = card.display_name() if card else "Anonymous"
        if counts[base] > 1:
            running[base] = running.get(base, 0) + 1
            result[p.id] = f"{base}({running[base]})"
        else:
            result[p.id] = base
    return result


def presence_snapshot(hub, presences=None):
    if presences is None:
        presences = HubPresence.query.filter_by(hub_id=hub.id).all()
    names = compute_display_names(presences)
    out = []
    for p in presences:
        card = Card.query.get(p.card_id)
        out.append({
            "user_id": p.user_id,
            "card_id": p.card_id,
            "display_name": names[p.id],
            "status": p.status,             # 'green' | 'red'
            "is_physical": p.is_physical,
            "is_blocked": p.is_blocked,
            "is_live": p.is_live,
            "approval_status": p.approval_status,
            "is_owner": p.user_id == hub.owner_user_id,
            "card": card.public_dict() if card else {},
        })
    # owner always pinned first (spec §6), then live-first, then by join order
    out.sort(key=lambda r: (not r["is_owner"], not r["is_live"]))
    return out


def emit_presence_list(hub_id):
    hub = Hub.query.get(hub_id)
    if not hub:
        return
    all_presences = HubPresence.query.filter_by(hub_id=hub_id).all()
    approved = [p for p in all_presences if p.approval_status == "approved"]
    live = [p for p in approved if p.is_live]

    names_all = compute_display_names(all_presences)  # shared numbering so (1)/(2) stay consistent everywhere

    def snap(presences):
        out = []
        for p in presences:
            card = Card.query.get(p.card_id)
            out.append({
                "user_id": p.user_id, "card_id": p.card_id,
                "display_name": names_all[p.id],
                "status": p.status, "is_physical": p.is_physical, "is_blocked": p.is_blocked,
                "is_live": p.is_live, "approval_status": p.approval_status,
                "is_owner": p.user_id == hub.owner_user_id,
                "card": card.public_dict() if card else {},
            })
        out.sort(key=lambda r: (not r["is_owner"], not r["is_live"]))
        return out

    # "who's here now" — the list every hub type has always had
    socketio.emit("presence_list", snap(live), room=f"hub:{hub_id}")

    if hub.hub_type == "professional":
        # Full attendee directory (survives people going offline — spec §6)
        socketio.emit("directory_list", snap(approved), room=f"hub:{hub_id}")
        # Pending-approval queue — owner only (spec §5)
        pending = [p for p in all_presences if p.approval_status == "pending"]
        payload = snap(pending)
        for sid in USER_SIDS.get(hub.owner_user_id, set()):
            socketio.emit("pending_list", payload, room=sid)


@socketio.on("connect")
def on_connect():
    """Register this connection for personal delivery (private messages,
    notifications) immediately — not just once they join a hub. This is what
    lets someone get notified of a new private message while they're
    anywhere in the app, not only while physically inside a hub room."""
    user = resolve_user_from_request()
    if user:
        SID_TO_USER[request.sid] = user.id
        USER_SIDS.setdefault(user.id, set()).add(request.sid)


@socketio.on("leave_hub")
def on_leave_hub(data=None):
    """Leave a hub's room without dropping the socket connection entirely —
    keeps the person reachable for private-message notifications elsewhere
    in the app."""
    hub_id = SID_TO_HUB.pop(request.sid, None)
    if hub_id:
        leave_room(f"hub:{hub_id}")


@socketio.on("join_hub")
def on_join_hub(data):
    user = resolve_user_from_request()
    if not user:
        emit("error_msg", {"error": "no session — reload the page"})
        return

    hub = Hub.query.filter_by(id=data.get("hub_id"), is_open=True).first()
    if not hub:
        emit("error_msg", {"error": "this hub is not open"})
        return

    if not hub.is_published and hub.owner_user_id != user.id:
        emit("error_msg", {"error": "hub still in draft — not published yet"})
        return

    active_card = Card.query.filter_by(user_id=user.id, is_active=True).first()
    if not active_card:
        emit("error_msg", {"error": "activate a card before entering a hub"})
        return

    # Conference hubs require a business card (spec §5.14) — a social card
    # gets a clear rejection rather than silently letting them in.
    if hub.hub_type == "professional" and active_card.card_type != "business":
        emit("error_msg", {
            "error": "hub_requires_business_card",
            "message": "האב הזה מיועד לכנס ודורש כרטיס ביקור עסקי. עברו לכרטיס עסקי או צרו אחד כדי להירשם.",
        })
        return

    join_room(f"hub:{hub.id}")
    SID_TO_USER[request.sid] = user.id
    SID_TO_HUB[request.sid] = hub.id
    USER_SIDS.setdefault(user.id, set()).add(request.sid)

    # replace any existing presence for this user in this hub (e.g. rejoining)
    existing = HubPresence.query.filter_by(hub_id=hub.id, user_id=user.id).first()
    is_physical = bool(hub.owner_public_ip) and (hub.owner_public_ip == get_client_ip())
    is_owner = (user.id == hub.owner_user_id)

    if existing:
        existing.card_id = active_card.id
        existing.is_physical = is_physical
        existing.is_live = True
        existing.last_seen = __import__("time").time()
        approval_status = existing.approval_status
    else:
        # New registrants to a professional hub start 'pending' unless the
        # organizer enabled auto-approve, or they're the owner themself.
        approval_status = "approved"
        if hub.hub_type == "professional" and not hub.auto_approve and not is_owner:
            approval_status = "pending"
        db.session.add(HubPresence(
            hub_id=hub.id, user_id=user.id, card_id=active_card.id,
            status="green" if active_card.is_open_to_contact else "red",
            is_physical=is_physical, is_live=True,
            approval_status=approval_status,
        ))
    db.session.commit()
    emit_presence_list(hub.id)

    if approval_status == "pending":
        # Give them just enough to show a "waiting for approval" screen —
        # no board history, no full attendee list — until the organizer acts.
        owner_card = hub_owner_card(hub)
        emit("hub_pending", {"hub": hub.public_dict(owner_card)})
        return

    board = BoardMessage.query.filter_by(hub_id=hub.id).order_by(BoardMessage.ts).limit(200).all()
    owner_card = hub_owner_card(hub)

    # Restore this person's private conversations *within this hub* too —
    # otherwise leaving and re-joining wipes the in-hub private panel even
    # though the messages are still safely in the database (spec item: history
    # must survive leaving/re-entering a hub).
    my_private = (
        PrivateMessage.query.filter_by(hub_id=hub.id)
        .filter(db.or_(PrivateMessage.from_user_id == user.id, PrivateMessage.to_user_id == user.id))
        .order_by(PrivateMessage.ts)
        .all()
    )
    private_history = {}
    for m in my_private:
        other_id = m.to_user_id if m.from_user_id == user.id else m.from_user_id
        sender_presence = HubPresence.query.filter_by(hub_id=hub.id, user_id=m.from_user_id).first()
        sender_card = Card.query.get(sender_presence.card_id) if sender_presence else None
        private_history.setdefault(other_id, []).append({
            "id": m.id, "hub_id": hub.id,
            "from_user_id": m.from_user_id, "to_user_id": m.to_user_id,
            "from_name": sender_card.display_name() if sender_card else resolve_display_name(m.from_user_id),
            "text": m.text, "image": m.image_url, "ts": m.ts,
        })

    emit("hub_state", {
        "hub": {**hub.public_dict(owner_card), "wifi_label": hub.wifi_label, "is_mine": hub.owner_user_id == user.id},
        "my_user_id": user.id,
        "board": [board_msg_dict(m, hub) for m in board],
        "private_history": private_history,
    })


@socketio.on("set_status")
def on_set_status(data):
    user_id = SID_TO_USER.get(request.sid)
    hub_id = SID_TO_HUB.get(request.sid)
    if not user_id or not hub_id:
        return
    status = data.get("status")
    if status not in ("green", "red"):
        return
    presence = HubPresence.query.filter_by(hub_id=hub_id, user_id=user_id).first()
    if presence:
        presence.status = status
        # Persist as the personal default for next time too (spec: this
        # replaces the old per-hub-only header toggle with a card-level
        # setting that still updates live from here).
        card = Card.query.get(presence.card_id)
        if card:
            card.is_open_to_contact = (status == "green")
        db.session.commit()
        emit_presence_list(hub_id)


def board_msg_dict(m, hub=None):
    sender_card = Card.query.get(m.sender_card_id)
    if hub is None:
        hub = Hub.query.get(m.hub_id)
    return {
        "id": m.id,
        "sender_user_id": m.sender_user_id,
        "sender_name": sender_card.display_name() if sender_card else "Anonymous",
        "sender_type": sender_card.card_type if sender_card else "social",
        "is_owner": bool(hub and hub.owner_user_id == m.sender_user_id),
        "text": m.text,
        "image": m.image_url,
        "ts": m.ts,
    }


@socketio.on("send_board_message")
def on_send_board_message(data):
