FIELD_NAMES = [
    "name", "nickname", "title", "company", "phone", "email",
    "instagram", "tiktok", "mood", "status", "bio",
]


def validate_card_payload(data):
    """At least one of name/nickname must be present AND visible."""
    name = (data.get("name") or "").strip()
    nickname = (data.get("nickname") or "").strip()
    name_visible = bool(data.get("name_visible", True))
    nickname_visible = bool(data.get("nickname_visible", False))

    if not name and not nickname:
        return "Provide a name or a nickname."
    if not ((name and name_visible) or (nickname and nickname_visible)):
        return "At least one of name / nickname must be visible."
    return None


@app.route("/api/cards", methods=["GET"])
def list_cards():
    user, _ = get_or_create_user()
    cards = Card.query.filter_by(user_id=user.id).order_by(Card.created_at).all()
    return jsonify([c.full_dict() for c in cards])


@app.route("/api/cards", methods=["POST"])
def create_card():
    user, _ = get_or_create_user()
    data = request.get_json(force=True)

    card_type = data.get("type")
    if card_type not in ("business", "social"):
        return jsonify({"error": "type must be 'business' or 'social'"}), 400

    err = validate_card_payload(data)
    if err:
        return jsonify({"error": err}), 400

    card = Card(user_id=user.id, card_type=card_type)
    apply_card_fields(card, data)

    # first card a user creates becomes active automatically
    existing_count = Card.query.filter_by(user_id=user.id).count()
    if existing_count == 0:
        card.is_active = True

    db.session.add(card)
    db.session.commit()
    return jsonify(card.full_dict())


@app.route("/api/cards/<card_id>", methods=["PUT"])
def update_card(card_id):
    user, _ = get_or_create_user()
    card = Card.query.filter_by(id=card_id, user_id=user.id).first()
    if not card:
        return jsonify({"error": "not found"}), 404

    data = request.get_json(force=True)
    err = validate_card_payload({
        "name": data.get("name", card.name),
        "nickname": data.get("nickname", card.nickname),
        "name_visible": data.get("name_visible", card.name_visible),
        "nickname_visible": data.get("nickname_visible", card.nickname_visible),
    })
    if err:
        return jsonify({"error": err}), 400

    apply_card_fields(card, data)
    db.session.commit()
    return jsonify(card.full_dict())


@app.route("/api/cards/<card_id>", methods=["DELETE"])
def delete_card(card_id):
    user, _ = get_or_create_user()
    card = Card.query.filter_by(id=card_id, user_id=user.id).first()
    if not card:
        return jsonify({"error": "not found"}), 404
    was_active = card.is_active
    db.session.delete(card)
    db.session.commit()

    if was_active:
        # promote another card to active, if any remain
        remaining = Card.query.filter_by(user_id=user.id).first()
        if remaining:
            remaining.is_active = True
            db.session.commit()

    return jsonify({"ok": True})


@app.route("/api/cards/<card_id>/activate", methods=["POST"])
def activate_card(card_id):
    user, _ = get_or_create_user()
    card = Card.query.filter_by(id=card_id, user_id=user.id).first()
    if not card:
        return jsonify({"error": "not found"}), 404

    Card.query.filter_by(user_id=user.id).update({Card.is_active: False})
    card.is_active = True
    db.session.commit()
    return jsonify(card.full_dict())


# ---------------------------------------------------------------------------
# Card photo gallery — multiple photos per card, each independently
# shown/hidden on the public card ("show in profile" toggle per photo).
# ---------------------------------------------------------------------------

@app.route("/api/cards/<card_id>/photos", methods=["POST"])
def add_card_photo(card_id):
    user, _ = get_or_create_user()
    card = Card.query.filter_by(id=card_id, user_id=user.id).first()
    if not card:
        return jsonify({"error": "not found"}), 404
    data = request.get_json(force=True)
    url = data.get("url")
    if not url:
        return jsonify({"error": "חסרה תמונה"}), 400
    max_order = db.session.query(db.func.max(CardPhoto.order)).filter_by(card_id=card_id).scalar() or 0
    has_profile_photo = CardPhoto.query.filter_by(card_id=card_id, is_profile_photo=True).first() is not None
    photo = CardPhoto(
        card_id=card_id, url=url, is_visible=True, order=max_order + 1,
        is_profile_photo=not has_profile_photo,  # first photo ever becomes the profile pic by default
    )
    db.session.add(photo)
    if not has_profile_photo:
        card.photo_url = url  # keep legacy field in sync
    db.session.commit()
    return jsonify({"id": photo.id, "url": photo.url, "is_visible": photo.is_visible, "is_profile_photo": photo.is_profile_photo})


@app.route("/api/cards/<card_id>/photos/<photo_id>", methods=["PUT"])
def update_card_photo(card_id, photo_id):
    """Toggle a single photo's 'show in profile' visibility, or set it as
    THE profile picture (unselecting any previous one — only one at a time)."""
    user, _ = get_or_create_user()
    card = Card.query.filter_by(id=card_id, user_id=user.id).first()
    if not card:
        return jsonify({"error": "not found"}), 404
    photo = CardPhoto.query.filter_by(id=photo_id, card_id=card_id).first()
    if not photo:
        return jsonify({"error": "not found"}), 404
    data = request.get_json(force=True)
    if "is_visible" in data:
        photo.is_visible = bool(data.get("is_visible"))
    if "is_profile_photo" in data:
        make_profile = bool(data.get("is_profile_photo"))
        if make_profile:
            CardPhoto.query.filter_by(card_id=card_id).update({CardPhoto.is_profile_photo: False})
            photo.is_profile_photo = True
            card.photo_url = photo.url  # keep legacy field in sync
        else:
            photo.is_profile_photo = False
    db.session.commit()
    return jsonify({"ok": True})


@app.route("/api/cards/<card_id>/photos/<photo_id>", methods=["DELETE"])
def delete_card_photo(card_id, photo_id):
    user, _ = get_or_create_user()
    card = Card.query.filter_by(id=card_id, user_id=user.id).first()
    if not card:
        return jsonify({"error": "not found"}), 404
    photo = CardPhoto.query.filter_by(id=photo_id, card_id=card_id).first()
    if not photo:
        return jsonify({"error": "not found"}), 404
    was_profile_photo = photo.is_profile_photo
    db.session.delete(photo)
    db.session.commit()
    if was_profile_photo:
        # auto-promote the next visible photo to profile picture, if any
        remaining = CardPhoto.query.filter_by(card_id=card_id, is_visible=True).order_by(CardPhoto.order).first()
        if remaining:
            remaining.is_profile_photo = True
        card.photo_url = remaining.url if remaining else ""
        db.session.commit()
    return jsonify({"ok": True})


def apply_card_fields(card, data):
    for f in FIELD_NAMES:
        if f in data:
            setattr(card, f, (data.get(f) or "").strip())
        vis_key = f + "_visible"
        if vis_key in data:
            setattr(card, vis_key, bool(data.get(vis_key)))
    if "photo_url" in data:
        card.photo_url = data.get("photo_url") or ""
    if "is_open_to_contact" in data:
        card.is_open_to_contact = bool(data.get("is_open_to_contact"))


