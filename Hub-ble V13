@app.route("/api/contacts", methods=["POST"])
def save_contact():
    """The recipient of a shared contact card explicitly saves it, with their
    own note, into their contacts list."""
    user, _ = get_or_create_user()
    data = request.get_json(force=True)
    hub = Hub.query.get(data.get("hub_id"))
    share = ContactShare(
        owner_user_id=user.id,
        from_user_id=data.get("from_user_id"),
        hub_id=data.get("hub_id"),
        hub_name_snapshot=data.get("hub_name") or (hub.name if hub else ""),
        card_snapshot=data.get("fields") or {},
        note=(data.get("note") or "").strip(),
    )
    db.session.add(share)
    db.session.commit()
    return jsonify({"ok": True, "id": share.id})


if __name__ == "__main__":
    port = int(os.environ.get("PORT", 5050))
    socketio.run(app, host="0.0.0.0", port=port, debug=False, allow_unsafe_werkzeug=True)

