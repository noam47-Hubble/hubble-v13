# Organizer broadcast — spec §"organizer can message everyone / an
# individual / a sub-group". Individual messaging already works via the
# normal private-message flow (the owner is just another participant from
# that angle). This covers "everyone" and a filtered sub-group.
# ---------------------------------------------------------------------------

@app.route("/api/hubs/<hub_id>/broadcast", methods=["POST"])
def broadcast_to_hub(hub_id):
    user, _ = get_or_create_user()
    hub = Hub.query.filter_by(id=hub_id, owner_user_id=user.id).first()
    if not hub:
        return jsonify({"error": "not found or not yours"}), 404
    data = request.get_json(force=True)
    text = (data.get("text") or "").strip()
    if not text:
        return jsonify({"error": "יש להזין טקסט לשידור"}), 400

    target = data.get("target", "all_approved")  # 'all_approved' | 'pending'
    query = HubPresence.query.filter_by(hub_id=hub_id)
    if target == "pending":
        query = query.filter_by(approval_status="pending")
    else:
        query = query.filter_by(approval_status="approved")
    recipients = [p for p in query.all() if p.user_id != user.id]

    my_name = user.reg_name or resolve_display_name(user.id)
    for p in recipients:
        db.session.add(PrivateMessage(hub_id=hub_id, from_user_id=user.id, to_user_id=p.user_id, text=text))
    db.session.commit()

    payload_base = {
        "hub_id": hub_id, "hub_name": f'📣 שידור מ-{hub.name}',
        "from_user_id": user.id, "from_name": f'📣 {my_name} (הודעת ארגונאי)',
        "text": text, "image": "",
    }
    for p in recipients:
        for sid in USER_SIDS.get(p.user_id, set()):
            socketio.emit("private_message", {**payload_base, "to_user_id": p.user_id, "id": None, "ts": None}, room=sid)
    return jsonify({"ok": True, "sent_to": len(recipients)})


@app.route("/api/hubs/<hub_id>/report", methods=["GET"])
def generate_hub_report(hub_id):
    """On-demand personal report for an attendee (spec §10). Not persisted —
    built fresh from live data every time. Only the fields each included
    person has marked visible are shown, same as everywhere else in the app.
    Export format was left open in the spec; the client renders this as a
    formatted page with a 'print / save as PDF' action, which covers both
    the "PDF" and "on-screen" options without extra dependencies."""
    user, _ = get_or_create_user()
    hub = Hub.query.get(hub_id)
    if not hub:
        return jsonify({"error": "not found"}), 404

    include_directory = request.args.get("directory", "true") == "true"
    include_contacts = request.args.get("contacts", "true") == "true"
    include_modules = request.args.get("modules", "true") == "true"

    owner_card = hub_owner_card(hub)
    report = {"hub": hub.public_dict(owner_card), "generated_at": time.time()}

    if include_modules:
        blocks = HubBlock.query.filter_by(hub_id=hub_id, is_visible=True).order_by(HubBlock.order).all()
        report["modules"] = [b.public_dict() for b in blocks]

    if include_directory:
        presences = HubPresence.query.filter_by(hub_id=hub_id, approval_status="approved").all()
        report["directory"] = presence_snapshot(hub, presences)

    if include_contacts:
        shares = ContactShare.query.filter_by(owner_user_id=user.id, hub_id=hub_id).order_by(ContactShare.ts).all()
        report["my_contacts"] = [{
            "card": s.card_snapshot, "note": s.note, "ts": s.ts,
        } for s in shares]

    return jsonify(report)


