"""
Hubble — cloud version, Phase 1: user identity + multi-card system.

Each browser gets a persistent device_id cookie, which maps to a User.
A User can hold multiple Cards (business and/or social). Exactly one
card is "active" at a time — that's the card used when entering hubs
(hub features land in Phase 2+).
"""

import os
import time
import uuid

from flask import Flask, request, jsonify, render_template, make_response, g
from flask_socketio import SocketIO, join_room, leave_room, emit

from models import (
    db, User, Card, CardPhoto, Hub, HubBlock, Favorite, ContactShare, ContactGroup,
    HubPresence, BoardMessage, PrivateMessage, gen_hub_serial,
)

app = Flask(__name__)
app.config["SECRET_KEY"] = os.environ.get("SECRET_KEY", "hubble-demo-not-for-production")
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DEFAULT_DB_PATH = os.path.join(BASE_DIR, "hubble.db")
db_url = os.environ.get("DATABASE_URL", f"sqlite:///{DEFAULT_DB_PATH}")
if db_url.startswith("postgres://"):
    # Render (and some other hosts) hand out the old "postgres://" scheme,
    # but SQLAlchemy 1.4+ requires "postgresql://" — same database, just the prefix.
    db_url = db_url.replace("postgres://", "postgresql://", 1)
app.config["SQLALCHEMY_DATABASE_URI"] = db_url
app.config["MAX_CONTENT_LENGTH"] = 25 * 1024 * 1024  # 25MB — allow real photos/audio through
db.init_app(app)
socketio = SocketIO(app, cors_allowed_origins="*", async_mode="threading",
                     max_http_buffer_size=25 * 1024 * 1024)  # default 1MB was silently dropping images/audio

with app.app_context():
    db.create_all()


# ---------------------------------------------------------------------------
# Identity: persistent device cookie -> User row
# ---------------------------------------------------------------------------

DEVICE_COOKIE = "hubble_device_id"


@app.before_request
def load_current_user():
    device_id = request.cookies.get(DEVICE_COOKIE)
    user = None
    new_device_id = None
    if device_id:
        user = User.query.filter_by(device_id=device_id).first()
    if not user:
        new_device_id = str(uuid.uuid4())
        user = User(device_id=new_device_id)
        db.session.add(user)
        db.session.commit()
    g.user = user
    g.new_device_id = new_device_id  # only set if we need to write a fresh cookie


@app.after_request
def persist_device_cookie(response):
    new_device_id = getattr(g, "new_device_id", None)
    if new_device_id:
        response.set_cookie(DEVICE_COOKIE, new_device_id, max_age=60 * 60 * 24 * 365, samesite="Lax", path="/")
    return response


def get_or_create_user():
    return g.user, g.user.device_id


def get_client_ip():
    """Respects X-Forwarded-For, since a cloud host (Render/Railway) sits behind a proxy."""
    fwd = request.headers.get("X-Forwarded-For")
    if fwd:
        return fwd.split(",")[0].strip()
    return request.remote_addr or ""


# Set once per process start (i.e. changes on every deploy/restart) so the
# browser can't keep serving a stale cached copy of app.js/style.css after a
# release — no manual bumping required.
APP_VERSION = str(int(time.time()))


@app.route("/")
def index():
    return render_template("index.html", v=APP_VERSION)


# ---------------------------------------------------------------------------
# Session identity — linking a second device/browser to the same person.
#
# Identity here is just a cookie, so a different browser or device looks
# like a brand-new anonymous person by default (this is why "My Hubs" can
# look empty on your phone if you opened the hub on your laptop). A short
# code lets someone deliberately link a second browser to their existing
# identity instead of creating a new one.
# ---------------------------------------------------------------------------

@app.route("/api/session", methods=["GET"])
def get_session():
    user, _ = get_or_create_user()
    return jsonify({"sync_code": user.sync_code})


@app.route("/api/session/link", methods=["POST"])
def link_session():
    user, _ = get_or_create_user()
    data = request.get_json(force=True)
    code = (data.get("code") or "").strip().upper()
    target = User.query.filter_by(sync_code=code).first()
    if not target:
        return jsonify({"error": "קוד לא נמצא"}), 404
    merge_user_into(user, target)
    resp = jsonify({"ok": True, "sync_code": target.sync_code})
    resp.set_cookie(DEVICE_COOKIE, target.device_id, max_age=60 * 60 * 24 * 365, samesite="Lax", path="/")
    g.new_device_id = None  # don't let after_request overwrite this with the throwaway anonymous id
    return resp


# ---------------------------------------------------------------------------
# Registration / login — attach a name + email/phone to a device, or log
# into an existing identity that already has that email/phone.
#
# This is deliberately unverified (no confirmation email/SMS) — it's a demo.
# The real behaviour it stands in for: on signup, check whether a person
# with this email/phone already exists; if so treat this browser as *them*
# (like the sync-code flow) instead of creating a duplicate identity.
# ---------------------------------------------------------------------------

def merge_user_into(source, target):
    """Move all of source's data over to target, then delete source.

    Used when someone registers/logs in with an email or phone that already
    belongs to another identity: rather than just switching the cookie (which
    would silently orphan anything created under the current anonymous
    session — cards, hubs, contacts...), we fold it into the existing
    account so nothing the person already did on this device gets lost.
    """
    if source.id == target.id:
        return
    db.session.query(Card).filter_by(user_id=source.id).update({Card.user_id: target.id})
    db.session.query(Hub).filter_by(owner_user_id=source.id).update({Hub.owner_user_id: target.id})
    db.session.query(Favorite).filter_by(user_id=source.id).update({Favorite.user_id: target.id})
    db.session.query(ContactGroup).filter_by(owner_user_id=source.id).update({ContactGroup.owner_user_id: target.id})
    db.session.query(ContactShare).filter_by(owner_user_id=source.id).update({ContactShare.owner_user_id: target.id})
    db.session.query(ContactShare).filter_by(from_user_id=source.id).update({ContactShare.from_user_id: target.id})
    db.session.query(HubPresence).filter_by(user_id=source.id).update({HubPresence.user_id: target.id})
    db.session.query(BoardMessage).filter_by(sender_user_id=source.id).update({BoardMessage.sender_user_id: target.id})
    db.session.query(PrivateMessage).filter_by(from_user_id=source.id).update({PrivateMessage.from_user_id: target.id})
    db.session.query(PrivateMessage).filter_by(to_user_id=source.id).update({PrivateMessage.to_user_id: target.id})
    db.session.delete(source)
    db.session.commit()


@app.route("/api/whoami", methods=["GET"])
def whoami():
    user, _ = get_or_create_user()
    return jsonify({
        "registered": user.is_registered(),
        "reg_name": user.reg_name,
        "email": user.email,
        "phone": user.phone,
    })


@app.route("/api/register", methods=["POST"])
def register():
    user, _ = get_or_create_user()
    data = request.get_json(force=True)
    name = (data.get("name") or "").strip()
    email = (data.get("email") or "").strip().lower() or None
    phone = (data.get("phone") or "").strip() or None

    if not name:
        return jsonify({"error": "יש להזין שם"}), 400
    if not email and not phone:
        return jsonify({"error": "יש להזין מייל או טלפון"}), 400

    existing = None
    if email:
        existing = User.query.filter(User.email == email, User.id != user.id).first()
    if not existing and phone:
        existing = User.query.filter(User.phone == phone, User.id != user.id).first()

    if existing:
        # Someone already registered with this email/phone. Fold whatever was
        # created under this (anonymous, pre-login) browser session into that
        # existing identity — cards, hubs, contacts, everything — instead of
        # just switching the cookie and leaving it behind.
        merge_user_into(user, existing)
        resp = jsonify({"ok": True, "logged_in_as_existing": True, "reg_name": existing.reg_name})
        resp.set_cookie(DEVICE_COOKIE, existing.device_id, max_age=60 * 60 * 24 * 365, samesite="Lax", path="/")
        g.new_device_id = None
        return resp

    user.reg_name = name
    user.email = email
    user.phone = phone
    db.session.commit()
    return jsonify({"ok": True, "logged_in_as_existing": False, "reg_name": name})


@app.route("/api/session/switch-account", methods=["POST"])
def switch_account():
    """Sign into a DIFFERENT already-registered account from this device —
    unlike /api/register's merge behavior (which is for restoring your own
    data after a lost cookie), this is a deliberate account switch, so
    it does NOT fold the current session's data into the target account."""
    data = request.get_json(force=True)
    email = (data.get("email") or "").strip().lower() or None
    phone = (data.get("phone") or "").strip() or None
    if not email and not phone:
        return jsonify({"error": "יש להזין מייל או טלפון"}), 400

    target = None
    if email:
        target = User.query.filter_by(email=email).first()
    if not target and phone:
        target = User.query.filter_by(phone=phone).first()
    if not target:
        return jsonify({"error": "לא נמצא חשבון עם הפרטים האלה"}), 404

    resp = jsonify({"ok": True, "reg_name": target.reg_name})
    resp.set_cookie(DEVICE_COOKIE, target.device_id, max_age=60 * 60 * 24 * 365, samesite="Lax", path="/")
    g.new_device_id = None
    return resp


@app.route("/api/session/new-account", methods=["POST"])
def new_account():
    """Sign out of the current identity on this device and start a brand
    new, empty one (so the person can then register a different identity
    from scratch, without it merging into whichever account was active)."""
    new_device_id = str(uuid.uuid4())
    fresh_user = User(device_id=new_device_id)
    db.session.add(fresh_user)
    db.session.commit()
    resp = jsonify({"ok": True})
    resp.set_cookie(DEVICE_COOKIE, new_device_id, max_age=60 * 60 * 24 * 365, samesite="Lax", path="/")
    g.new_device_id = None
    return resp


