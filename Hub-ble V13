def resolve_display_name(user_id):
    card = Card.query.filter_by(user_id=user_id, is_active=True).first()
    if not card:
        card = Card.query.filter_by(user_id=user_id).first()
    return card.display_name() if card else "Anonymous"


@app.route("/api/messages", methods=["GET"])
def list_my_messages():
    """One row per correspondent (not per message) — the inbox view. Each
    row carries whether that person is currently green (open to comms) in
    some open hub, so the UI can show/enable the reply composer accordingly."""
    user, _ = get_or_create_user()
    received = PrivateMessage.query.filter_by(to_user_id=user.id).all()
    sent = PrivateMessage.query.filter_by(from_user_id=user.id).all()

    by_correspondent = {}
    for m in received + sent:
        other_id = m.from_user_id if m.to_user_id == user.id else m.to_user_id
        entry = by_correspondent.setdefault(other_id, {"last_ts": 0, "last_text": "", "hub_name": "—"})
        if m.ts and m.ts >= entry["last_ts"]:
            entry["last_ts"] = m.ts
            entry["last_text"] = m.text or ("📷 תמונה" if m.image_url else "")
            hub = Hub.query.get(m.hub_id) if m.hub_id else None
            entry["hub_name"] = hub.name if hub else "הודעה ישירה"

    out = []
    for other_id, entry in by_correspondent.items():
        out.append({
            "user_id": other_id,
            "from_name": resolve_display_name(other_id),
            "hub_name": entry["hub_name"],
            "last_text": entry["last_text"],
            "ts": entry["last_ts"],
            "is_green_now": _contact_is_green_now(other_id),
        })
    out.sort(key=lambda r: r["ts"], reverse=True)
    return jsonify(out)


@app.route("/api/messages/thread/<other_user_id>", methods=["GET"])
def get_message_thread(other_user_id):
    """Full back-and-forth with one specific person, for the chat view
    inside 'My Messages'."""
    user, _ = get_or_create_user()
    msgs = (
        PrivateMessage.query.filter(
            db.or_(
                db.and_(PrivateMessage.from_user_id == user.id, PrivateMessage.to_user_id == other_user_id),
                db.and_(PrivateMessage.from_user_id == other_user_id, PrivateMessage.to_user_id == user.id),
            )
        )
        .order_by(PrivateMessage.ts)
        .all()
    )
    out = [{
        "id": m.id, "from_user_id": m.from_user_id, "to_user_id": m.to_user_id,
        "mine": m.from_user_id == user.id,
        "text": m.text, "image": m.image_url, "ts": m.ts,
    } for m in msgs]
    return jsonify(out)


